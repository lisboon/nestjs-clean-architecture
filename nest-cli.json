{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "entryFile": "infra/http/main.js",
  "compilerOptions": {
    "plugins": [
      {
        "name": "@nestjs/swagger",
        "options": {
          "classValidatorShim": true,
          "dtoFileNameSuffix": [".dto.ts"],
          "introspectComments": false
        }
      }
    ],
    "deleteOutDir": true,
    "builder": "swc",
    "typeCheck": true
  }
}
